{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@locales/*": ["./src/locales/*"]
    }
  },
  "include": ["src/server/**/*", "src/shared/**/*", "src/locales/*.json"]
}
