{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "preserve",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "paths": {
      "@/*": ["./src/client/*"],
      "@shared/*": ["./src/shared/*"],
      "@locales/*": ["./src/locales/*"],
      "@native-platform": ["./src/client/platform/none.ts"]
    }
  },
  "include": ["src/client/**/*", "src/shared/**/*", "src/locales/*.json", "src/client/**/*.vue", "env.d.ts"],
  "exclude": ["src/client/sw/**"]
}
