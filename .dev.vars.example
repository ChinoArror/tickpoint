# Template for local development secrets and overrides.
# Copy to .dev.vars, or run `node scripts/sync-secrets.mjs --local` to generate
# .dev.vars from .design/secret.json. Never commit real values.
# See docs/CONFIGURATION.md for every variable.

APP_ENV=development
APP_ORIGIN=http://localhost:5173
DEV_AUTH_BYPASS=true

# Secrets (placeholders)
AUTH_APP_SECRET=<app-secret from .design/secret.json>
GEMINI_API_KEY=<GeminiApiKey from .design/secret.json>

# Web Push (generated by scripts/sync-secrets.mjs into .design/vapid.json)
VAPID_PUBLIC_KEY=<generated VAPID public key>
VAPID_PRIVATE_KEY=<generated VAPID private key>

# Optional email provider (leave unset while EMAIL_PROVIDER is none)
# RESEND_API_KEY=<resend api key>
