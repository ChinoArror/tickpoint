{
  "name": "tickpoint",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TickPoint - Make Every Moment Count.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "build:fast": "vite build",
    "preview": "vite build && wrangler dev",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply tickpoint-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tickpoint-db --remote",
    "secrets:sync": "node scripts/sync-secrets.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^21.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.13",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fullcalendar/core": "^7.1.2",
    "@fullcalendar/vue3": "^7.1.2",
    "@tanstack/vue-query": "^5.104.2",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "echarts": "^6.1.0",
    "hono": "^4.13.13",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.3",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "temporal-polyfill": "^1.0.5",
    "vue": "^3.5.43",
    "vue-draggable-plus": "^0.6.1",
    "vue-echarts": "^8.3.2",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261006.1": true,
    "vue-demi@0.14.10": true,
    "sharp@0.35.2": true,
    "sharp@0.35.5": true
  }
}
