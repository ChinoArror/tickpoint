<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext anywhere. Trust only the system CA store (no user-added CAs, no debug overrides). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
