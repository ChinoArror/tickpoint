{
  "name": "tickpoint-android",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "TickPoint Android shell (Capacitor). Builds the root Vue app into www/ and wraps it in a native project.",
  "scripts": {
    "build:web": "vite build --config vite.config.ts",
    "sync": "npm run build:web && npx cap sync android",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate:assets": "node scripts/generate-android-assets.mjs",
    "release": "node scripts/release.mjs",
    "verify": "node scripts/verify.mjs",
    "emulator:test": "node scripts/emulator-test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
